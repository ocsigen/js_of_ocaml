#[if(wasi)]
{
    const symlink_str = "symlink";

    #[export]
    #[export = "caml_unix_symlink"]
    fn unix_symlink(to_dir: &eq, o: &eq, n: &eq) -> &eq {
        let flags: i32;
        let path = o as &bytes;
        let len = path.length();
        let op = write_string_to_memory(0, 0, path);
        // Resolve the target path without raising, so that $op is always freed
        // below even if resolving the second path fails.
        let (np_fd, np_addr, np_len) = wasi_resolve_path(n);
        let arg = n;
        let res = 44; // ENOENT
