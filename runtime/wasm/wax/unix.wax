    const chmod_str = "chmod";

    #[export]
    #[export = "caml_unix_chmod"]
    fn unix_chmod(path: &eq, perms: &eq) -> &eq {
        // WASI has no notion of permissions, so the mode change is a no-op; but
        // still report a missing path like native (which raises ENOENT) instead
        // of silently succeeding. We can only check that the path exists.
        let (p_fd, p_addr, p_len) = unix_resolve_path(chmod_str, path);
        let buffer = get_buffer();
        let res = path_filestat_get(p_fd, 1, p_addr, p_len, buffer);
        free(p_addr);
        caml_unix_error_if(res, chmod_str, path);
        0 as &i31;
    }
}
