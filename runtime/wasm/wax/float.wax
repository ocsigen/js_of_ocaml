#[if(wasi)]
{
    import "io" const IO_BUFFER_SIZE: i32;
    import "libc" {
        #[import = "memory"]
        memory m: i32 [2];
        fn free(i32);
        fn format_float(i32, i32, i32, f64) -> i32;
        fn strtod(i32, i32) -> f64;
        fn exp(f64) -> f64;
    }
    import "wasi_memory" {
        fn checked_malloc(i32) -> i32;
        fn get_buffer() -> i32;
        fn write_string_to_memory(i32, i32, &eq) -> i32;
        fn release_memory(i32, i32);
        fn blit_string_to_memory(i32, &bytes);
        fn blit_memory_to_string(i32, i32) -> &bytes;
    }
}
#[else]
{
    import "bindings" {
        fn format_float(f64, i32, i32) -> &?extern;
        #[import = "identity"]
        fn parse_float(&?extern) -> f64;
    }
    import "Math" fn exp(f64) -> f64;
}
import "fail" {
    fn caml_failwith(&eq);
    fn caml_invalid_argument(&eq);
}
import "ints" {
    const lowercase_hex_table: &chars;
    const pow10: &int64s;
    fn num_digits(i64) -> i32;
    fn write_decimal(&bytes, i32, i64);
    fn format_decimal(i64, i32) -> &bytes;
}
import "jsstring" {
    fn jsstring_of_bytes(&bytes) -> &?extern;
    fn bytes_of_jsstring(&?extern) -> &bytes;
}

type float = { f: f64 };
type bytes = [mut i8];
type block = [mut &eq];

type chars = [i8];

const infinity: &chars = "infinity";

const nan_chars: &chars = "nan";

#[export]
fn Double_val(v: &eq) -> f64 {
    (v as &float).f;
}

#[export]
fn caml_hexstring_of_float(v: &eq, vprec: &eq, vstyle: &eq) -> &eq {
    let prec = vprec as i32_s;
    let style = vstyle as i32_s;
    let b = (v as &float).f.to_bits();
    let sign = (b >>u 63) as i32;
    let exp = (b >>u 52) as i32 & 0x7FF;
    let m = b & (1 << 52) - 1;
    let i = sign | (style != '-');
    let s: &bytes;
    s =
        'sign: do {
            let len: i32;
            if exp == 0x7FF {
                let txt =
                    if !m {
                        infinity;
                    } else {
                        nan_chars;
                    };
                len = txt.length();
                s = [0; i + len];
                s.copy(i, txt, 0, len);
                br 'sign s;
            }
            if !exp {
                if m != 0 {
                    exp = -1022;
                }
            } else {
                exp -= 1023;
                m |= 1 << 52;
            }
            let frac: i64;
            if prec <u 13 {
                let unit = 1 << (52 - (prec << 2)) as i64_s;
                let half = unit >>u 1;
                let mask = unit - 1;
                frac = m & mask;
                m &= -1 ^ mask;
                if (frac >u half) | (frac == half) & ((m & unit) != 0) {
                    m += unit;
                }
            }
            frac = m << 12;
            let j = 0;
            while frac != 0 : (frac <<= 4) {
                j += 1;
            }
            if prec <s j {
                prec = j;
            }
            let d: i32;
            if exp >=s 0 {
                d = exp;
            } else {
                d = 0 - exp;
            }
            j = 0;
            'count: loop {
                j += 1;
                d /u= 10;
                br_if 'count d;
            }
            len = i + prec + (6 + j);
            if !prec {
                len -= 1;
            }
            s = [0; len];
            if exp >=s 0 {
                d = exp;
            } else {
                d = 0 - exp;
            }
            'write: loop {
                len -= 1;
                s[len] = '0' + d %u 10;
                d /u= 10;
                br_if 'write d;
            }
            s[len - 1] = exp >=s 0?'+':'-';
            s[i] = '0';
            s[i + 1] = 'x';
            s[i + 2] = (m >>u 52) as i32 + '0';
            i += 3;
            if prec >s 0 {
                s[i] = '.';
                i += 1;
                frac = m << 12;
                'write: loop {
                    s[i] = lowercase_hex_table[(frac >>u 60) as i32] as i32_u;
                    frac <<= 4;
                    prec -= 1;
                    i += 1;
                    br_if 'write prec >s 0;
                }
            }
            s[i] = 'p';
            s;
        };
    if sign {
        s[0] = '-';
    } else {
        if style != '-' {
            s[0] = style;
        }
    }
    s;
}

const format_error = "format_float: bad format";

// Parse a format "%[+ ][.prec](e|E|f|F|g|G)". The conversion is 0 for
// %e, 1 for %f and 2 for %g, and -1 if the format is not of this form.
fn parse_format(s: &bytes) -> (i32, i32, i32, i32) {
    let len = s.length();
    let i = 1;
    let sign_style: i32;
    let precision: i32;
    let conversion: i32;
    let uppercase: i32;
    'return: do {
        'bad_format: do {
            br_if 'bad_format len <u 2;
            br_if 'bad_format s[0] as i32_u != '%';
            let c = s[1] as i32_u;
            if c == '+' {
                sign_style = 1;
                i += 1;
            }
            if c == ' ' {
                sign_style = 2;
                i += 1;
            }
            br_if 'bad_format i == len;
            if s[i] as i32_u == '.' {
                'precision: loop {
                    i += 1;
                    br_if 'bad_format i == len;
                    c = s[i] as i32_u;
                    if c - '0' <u 10 {
                        precision = precision * 10 + (c - '0');
                        br 'precision;
                    }
                }
            } else {
                // No precision: [$c] still holds the char read for the "."
                // test (a sign flag like "+"/" " when one was consumed), not
                // the conversion letter. Load it so the checks below see the
                // real conversion, otherwise "%+f"/"% f" wrongly raise.
                c = s[i] as i32_u;
                precision = 6;
            }
            br_if 'bad_format i + 1 != len;
            uppercase = c <s 'a';
            conversion = (c & 0xdf) - 'E';
            br_if 'return conversion <=u 2;
        }
        conversion = -1;
    }
    sign_style;
    precision;
    conversion;
    uppercase;
}

type int64s = [i64];

const pow5: &int64s =
    [
        1,
        5,
        25,
        125,
        625,
        3125,
        15625,
        78125,
        390625,
        1953125,
        9765625,
        48828125,
        244140625,
        1220703125,
        6103515625,
        30517578125,
        152587890625,
        762939453125,
        3814697265625,
        19073486328125,
        95367431640625,
        476837158203125,
        2384185791015625,
        11920928955078125,
        59604644775390625,
        298023223876953125,
        1490116119384765625,
        7450580596923828125,
    ];

// Write x (finite, > 0) as m * 2^e, with m odd
fn decompose(x: f64) -> (i64, i32) {
    let b = x.to_bits();
    let e = (b >>u 52) as i32;
    let m = b & 0xFFFFFFFFFFFFF;
    if e {
        m |= 0x10000000000000;
        e -= 1075;
    } else {
        e = -1074;
    }
    let tz = m.ctz();
    m >>u tz;
    e + tz as i32;
}

// Exact decimal expansion of x (finite, >= 0) as n * 10^-k, if n
// fits in an unsigned 64-bit integer. The last result tells whether
// it does.
fn exact_decimal(x: f64) -> (i64, i32, i32) {
    if x == 0 {
        return (0, 0, 1);
    }
    let (m, e) = decompose(x);
    if e >=s 0 {
        // n = m * 2^e
        if e <=u m.clz() as i32 {
            return (m << e as i64_u, 0, 1);
        }
    } else {
        // x = m * 5^-e * 10^e
        e = 0 - e;
        if e <=u 27 {
            let p = pow5[e];
            // m * p < 2^64? With b the sum of the numbers of
            // leading zeros, 2^(126 - b) <= m * p < 2^(128 - b), so
            // only b = 63 needs a division
            let b = (m.clz() + p.clz()) as i32;
            if
                if b >=u 64 => i32 {
                    1;
                } else {
                    if b == 63 {
                        m <=u -1 /u p;
                    } else {
                        0;
                    }
                } {
                return (m * p, e, 1);
            }
        }
    }
    0;
    0;
    0;
}

// Round n (unsigned) to a multiple of 10^r (r > 0), ties to even, and
// divide by 10^r
fn round_digits(n: i64, r: i32) -> i64 {
    // n < 10^20 / 2
    if r >=u 20 {
        return 0;
    }
    let p = pow10[r];
    let q = n /u p;
    let rem = n - q * p;
    let half = p >>u 1;
    if
        (rem >u half) | 
            // tie and q odd (i64.eq is 0 or 1, so the bitwise and
            // keeps only the low bit of q)
            (rem == half) & q as i32 {
        q += 1;
    }
    q;
}

const zero_digits = "0";

// Holds the digits computed by $exact_digits (at most 20, as
// n < 2^64), until $layout copies them
const digit_buffer: &bytes = [0; 20];

// The significant digits of n * 10^-k, rounded as the conversion
// requires, possibly with trailing zeros ($layout handles them), and
// the decimal exponent e of the first digit (d0.d1d2... * 10^e). Zero
// is "0" with e = 0.
fn exact_digits(n: i64, k: i32, conversion: i32, prec: i32) -> (&bytes, i32, i32) {
    if !n {
        return (zero_digits, 1, 0);
    }
    let nd: i32;
    // number of digits to drop
    let r =
        if conversion == 1 {
            k - prec;
        } else {
            (nd := num_digits(n))
                - if conversion {
                      prec?prec:1;
                  } else {
                      prec + 1;
                  };
        };
    if r >s 0 {
        n = round_digits(n, r);
        if !n {
            return (zero_digits, 1, 0);
        }
        nd = num_digits(n);
    } else {
        r = 0;
        if conversion == 1 {
            nd = num_digits(n);
        }
    }
    write_decimal(digit_buffer, nd, n);
    digit_buffer;
    nd;
    // the value is now n * 10^(r - k)
    nd + r - (k + 1);
}

// Lay out the digits d0.d1d2... * 10^e (with d0 <> 0, or d = "0" and
// e = 0), padded with zeros, as %e, %f or %g would with precision
// prec. For %e and %g, the digits must already be rounded to the
// right number of significant digits; for %f, at 10^-prec.
fn layout(
    d: &bytes,
    nd: i32,
    e: i32,
    sign: i32,
    conversion: i32,
    prec: i32,
    uppercase: i32,
) -> &bytes {
    if conversion == 2 {
        // %g: no trailing zeros
        'strip: loop {
            if nd >u 1 {
                if d[nd - 1] as i32_u == '0' {
                    nd -= 1;
                    br 'strip;
                }
            }
        }
        if (e <s -4) | (e >=s (prec?prec:1)) {
            conversion = 0;
            prec = nd - 1;
        } else {
            conversion = 1;
            prec = nd - (e + 1);
            if prec <s 0 {
                prec = 0;
            }
        }
    }
    let len = (sign != 0) + (prec?prec + 1:0);
    let s: &?bytes;
    let i: i32;
    let j: i32;
    let n: i32;
    if conversion {
        // %f: digits from 10^max(e,0) down to 10^-prec
        j = e >s 0?e:0;
        len += j + 1;
        s = ['0'; len];
        if sign {
            s[0] = sign;
            i = 1;
        }
        // position of 10^0 in s
        let a = i + j;
        if prec {
            s[a + 1] = '.';
        }
        // digit d[n] stands for 10^(e - n)
        'write: loop {
            if n <u nd {
                j = e - n;
                if j >=s 0 - prec {
                    s[a - j + (j <s 0)] = d[n] as i32_u;
                    n += 1;
                    br 'write;
                }
            }
        }
    } else {
        // %e
        n = e <s 0?0 - e:e;
        len += n >=u 100?6:5;
        s = ['0'; len];
        if sign {
            s[0] = sign;
            i = 1;
        }
        s[i] = d[0] as i32_u;
        if prec {
            s[i + 1] = '.';
            j = 1;
            while j <u (nd <=u prec?nd:prec + 1) : (j += 1) {
                s[i + (j + 1)] = d[j] as i32_u;
            }
        }
        // exponent, at least two digits
        i = len - 1;
        'exp: loop {
            s[i] = '0' + n %u 10;
            n /u= 10;
            i -= 1;
            br_if 'exp n;
        }
        i = len - (len - i >=s 4?5:4);
        s[i] = uppercase?'E':'e';
        s[i + 1] = e <s 0?'-':'+';
    }
    s!;
}

// The sign character of f: '-', or '+' / ' ' for formats "%+" / "% ",
// or 0 for none
fn sign_char(f: f64, style: i32) -> i32 {
    if f.to_bits() <s 0 {
        return '-';
    }
    style == 1?'+':style == 2?' ':0;
}

const inf_chars: &chars = "inf";

// Format x (finite, >= 0) using integer arithmetic, if its exact
// decimal expansion is short enough
fn format_exact(x: f64, sign: i32, conversion: i32, prec: i32, uppercase: i32) -> &?bytes {
    let (n, k, ok) = exact_decimal(x);
    if !ok {
        return null;
    }
    // an integer which %g prints in full (at most P digits, with
    // P = max(prec, 1)), or %.0f: its digits only
    if !k {
        let p: i32;
        if
            if conversion == 2 => i32 {
                p = prec?prec:1;
                if p >=u 20 {
                    1;
                } else {
                    n <u pow10[p];
                }
            } else {
                (conversion == 1) & !prec;
            } {
            become format_decimal(n, sign);
        }
    }
    exact_digits(n, k, conversion, prec);
    layout(_, _, _, sign, conversion, prec, uppercase);
}

#[if(wasi)]
{
    #[export]
    fn caml_format_float(vfmt: &eq, arg: &eq) -> &eq {
        let fmt = vfmt as &bytes;
        let d = (arg as &float).f;
        let (sign_style, precision, conversion, uppercase) = parse_format(fmt);
        let res: &?bytes;
        if (conversion >=s 0) & (d - d == 0) {
            res = format_exact(d.abs(), sign_char(d, sign_style), conversion, precision, uppercase);
            if !res {
            } else {
                return res!;
            }
        }
        let buffer = get_buffer();
        let fmt_len = fmt.length();
        blit_string_to_memory(buffer, fmt);
        m.store8(buffer + fmt_len, 0);
        let out_buffer = buffer + (fmt_len + 1);
        let avail = IO_BUFFER_SIZE - fmt_len;
        let len = format_float(out_buffer, avail, buffer, d);
        if len >=u avail {
            out_buffer = checked_malloc(len + 1);
            _ = format_float(out_buffer, len + 1, buffer, d);
        }
        res = blit_memory_to_string(out_buffer, len);
        if len >=u avail {
            free(out_buffer);
        }
        res!;
    }
}
#[else]
{
    // Is x (finite, > 0) halfway between two multiples of 10^-k, that is,
    // is 2 * x * 10^k an odd integer?
    fn is_tie(x: f64, k: i32) -> i32 {
        let (m, e) = decompose(x);
        // 2 * x * 10^k = m * 5^k * 2^(e + 1 + k), with m odd
        if e + (k + 1) {
            return 0;
        }
        if k >=s 0 {
            return 1;
        }
        // m must be a multiple of 5^-k; m < 2^53 < 5^23
        k = 0 - k;
        if k >u 22 {
            return 0;
        }
        !(m %u pow5[k]);
    }

    // toFixed and toExponential round ties away from zero, while C
    // rounds them to even. The digit s[i] stands for 10^-k: on a tie, it
    // is one too many iff it is odd.
    fn round_half_even(s: &bytes, i: i32, x: f64, k: i32) {
        let c = s[i] as i32_u;
        if c & 1 // odd digit
        {
            if is_tie(x, k) {
                s[i] = c - 1;
            }
        }
    }

    // Format x (finite, > 0) using JavaScript's toExponential or toFixed
    fn format_js(x: f64, sign: i32, conversion: i32, prec: i32, uppercase: i32) -> &bytes {
        let s: &bytes;
        let len: i32;
        if conversion == 1 {
            // "ddd.ddd"
            s = bytes_of_jsstring(format_float(x, prec, 1));
            len = s.length();
            round_half_even(s, len - 1, x, prec);
            if !sign {
                return s;
            }
            let r: &bytes = [sign; len + 1];
            r.copy(1, s, 0, len);
            return r;
        }
        // "d.ddde+x" or "de+x", with prec + 1 digits
        if conversion == 2 {
            prec = (prec?prec:1) - 1;
        }
        s = bytes_of_jsstring(format_float(x, prec, 0));
        len = s.length();
        let j = 1;
        while s[j] as i32_u != 'e' {
            j += 1;
        }
        let neg = s[j + 1] as i32_u == '-';
        let i = j + 2;
        let e: i32;
        while i <u len : (i += 1) {
            e = e * 10 + (s[i] as i32_u - '0');
        }
        if neg {
            e = 0 - e;
        }
        // remove the decimal point, leaving the digits in s[0..prec]
        if prec {
            s.copy(1, s, 2, prec);
        }
        round_half_even(s, prec, x, prec - e);
        layout(s, prec + 1, e, sign, conversion, !conversion?prec:prec + 1, uppercase);
    }

    #[export]
    fn caml_format_float(vfmt: &eq, arg: &eq) -> &eq {
        let f = (arg as &float).f;
        let (sign_style, precision, conversion, uppercase) = parse_format(vfmt as &bytes);
        if conversion <s 0 {
            caml_invalid_argument(format_error);
        }
        let sign = sign_char(f, sign_style);
        if f - f == 0 {
            let res = format_exact(f.abs(), sign, conversion, precision, uppercase);
            if !res {
                return format_js(f.abs(), sign, conversion, precision, uppercase);
            } else {
                return res!;
            }
        }
        // infinity or nan
        let txt =
            if f == f {
                inf_chars;
            } else {
                // no minus sign for nan
                sign = sign_char(f.abs(), sign_style);
                nan_chars;
            };
        let i = sign != 0;
        let len = txt.length();
        let s: &bytes = [sign; i + len];
        s.copy(i, txt, 0, len);
        if uppercase {
            'uppercase: loop {
                let c = s[i] as i32_u;
                s[i] = c - 32;
                i += 1;
                br_if 'uppercase i <u s.length();
            }
        }
        s;
    }
}

fn caml_float_of_hex(err_msg: &eq, s: &bytes, i: i32) -> f64 {
    let len = s.length();
    let dec_point = -1;
    'error: do {
        let d: i32;
        let m: i64;
        let exp: i32;
        let n_bits: i32;
        let m_bits: i32;
        let x_bits: i32;
        'parse: while i <u len {
            let c = s[i] as i32_u;
            i += 1;
            if c == '.' {
                br_if 'error dec_point >=s 0;
                dec_point = n_bits;
                br 'parse;
            }
            if (c == 'p') | (c == 'P') {
                br_if 'error i == len;
                c = s[i] as i32_u;
                i += 1;
                let negative: i32;
                // an optional sign (only one)
                if (c == '-') | (c == '+') {
                    negative = c == '-';
                    br_if 'error i == len;
                    c = s[i] as i32_u;
                    i += 1;
                }
                'overflow: do {
                    'parse_exponent: loop {
                        br_if 'error c - '0' >=u 10;
                        d = c - '0';
                        exp = exp * 10 + d;
                        br_if 'overflow exp <u d;
                        // Any exponent this large saturates the double
                        // to inf/0; stop accumulating before [exp * 10]
                        // can wrap around 2^32 and slip back into range.
                        br_if 'overflow exp >=u 0x10000000;
                        if i != len {
                            c = s[i] as i32_u;
                            i += 1;
                            br 'parse_exponent;
                        }
                    }
                    if negative {
                        br_if 'overflow exp >=u 0x80000000;
                        exp = 0 - exp;
                    } else {
                        br_if 'overflow exp >=u 0x80000000;
                    }
                    br 'parse;
                }
                if negative | !m {
                    return 0;
                } else {
                    return inf;
                }
            }
            if c - '0' <u 10 {
                d = c - '0';
            } else {
                if c - 'a' <u 6 {
                    d = c - 87;
                } else {
                    if c - 'A' <u 6 {
                        d = c - 55;
                    } else {
                        br 'error;
                    }
                }
            }
            n_bits += 4;
            br_if 'parse !d & !m;
            if m_bits <u 60 {
                m = (m << 4) + d as i64_u;
                m_bits += 4;
            } else {
                if d {
                    m |= 1;
                }
                x_bits += 4;
            }
        }
        br_if 'error !n_bits;
        let adj = x_bits;
        if dec_point >=s 0 {
            adj += dec_point - n_bits;
        }
        if (adj >s 0) & (exp >s 0x7fffffff - adj) {
            exp = 0x7fffffff;
        } else {
            if (adj <s 0) & (exp <s 0x80000000 - adj) {
                exp = 0x80000000;
            } else {
                exp += adj;
            }
        }
        // If the result is subnormal, m would be rounded by the conversion
        // below and then again by ldexp. To avoid this, round m to odd at
        // two bits below the subnormal precision (the exponent of these two
        // extra bits is DBL_MIN_EXP - DBL_MANT_DIG - 2 = -1076). If the
        // result is subnormal, the conversion is then exact or a tie, and
        // ties round to even, which ldexp then scales exactly. Otherwise,
        // the conversion rounds once (round to odd keeps the information
        // needed) and ldexp is exact.
        if exp <s -1076 {
            adj = -1076 - exp;
            m =
                if adj <u 60 {
                    m >>u adj as i64_u | ((m & (1 << adj as i64_u) - 1) != 0) as i64_u;
                } else {
                    (m != 0) as i64_u;
                };
            exp = -1076;
        }
        // Convert the mantissa to FP (m has 60 bits at most)
        let f = m as f64_s;
        if exp {
            f = ldexp(f, exp);
        }
        return f;
    }
    caml_failwith(err_msg);
    0;
}

type f64s = [f64];

const exact_pow10: &f64s =
    [
        1e0,
        1e1,
        1e2,
        1e3,
        1e4,
        1e5,
        1e6,
        1e7,
        1e8,
        1e9,
        1e10,
        1e11,
        1e12,
        1e13,
        1e14,
        1e15,
        1e16,
        1e17,
        1e18,
        1e19,
        1e20,
        1e21,
        1e22,
    ];

// Parse s[i..len) as "digits[.digits][(e|E)[+-]digits]" (with at least
// one mantissa digit), when this can be done exactly with a single
// floating-point operation (Clinger's fast path): the significant
// digits w fit in 53 bits and the value is w * 10^e with |e| <= 22
// (10^e is then exact, and so is the correctly rounded product or
// quotient). The second result tells whether it succeeded.
fn parse_decimal_fast(s: &bytes, i: i32, len: i32) -> (f64, i32) {
    'fail: do {
        let c: i32;
        let w: i64;
        let digits: i32;
        let e: i32;
        'mantissa: loop {
            if i <u len {
                c = s[i] as i32_u - '0';
                let frac: i32;
                if c <u 10 {
                    digits += 1;
                    e -= frac;
                    // leading zeros are not significant
                    if c | (w != 0) {
                        let nd: i32;
                        nd += 1;
                        br_if 'fail nd >u 19;
                        w = w * 10 + c as i64_u;
                    }
                    i += 1;
                    br 'mantissa;
                }
                if !frac & (c == '.' - '0') {
                    frac = 1;
                    i += 1;
                    br 'mantissa;
                }
            }
        }
        br_if 'fail !digits;
        if i <u len {
            br_if 'fail (s[i] as i32_u | 0x20) != 'e';
            i += 1;
            br_if 'fail i >=u len;
            c = s[i] as i32_u;
            let neg: i32;
            if (c == '-') | (c == '+') {
                neg = c == '-';
                i += 1;
            }
            br_if 'fail i >=u len;
            let x: i32;
            'exponent: loop {
                c = s[i] as i32_u - '0';
                br_if 'fail c >=u 10;
                // large exponents are handled by the slow path
                br_if 'fail x >u 100000;
                x = x * 10 + c;
                i += 1;
                br_if 'exponent i <u len;
            }
            e += neg?0 - x:x;
        }
        if !w {
            return (0, 1);
        }
        br_if 'fail w >u 0x20000000000000;
        if e <s 0 {
            br_if 'fail e <s -22;
            return (w as f64_u / exact_pow10[0 - e], 1);
        }
        if e >s 22 {
            // w * 10^(e - 22) may still be an exact integer
            br_if 'fail e >s 37;
            let p = pow10[e - 22];
            br_if 'fail w >u 0x20000000000000 /u p;
            w *= p;
            e = 22;
        }
        return (w as f64_u * exact_pow10[e], 1);
    }
    0;
    0;
}

fn on_whitespace(s: &bytes, i: i32) -> i32 {
    let c = s[i] as i32_u;
    (c == ' ') | (c - 9 <u 5);
}

#[export]
fn caml_parse_float(err_msg: &eq, v: &eq) -> &eq {
    let s = v as &bytes;
    let len = s.length();
    let i: i32;
    let j: i32;
    while i <u len : (i += 1) {
        if '_' == s[i] as i32_u {
            j += 1;
        }
    }
    let s': &bytes;
    let c: i32;
    if j {
        s' = [0; len - j];
        i = 0;
        j = 0;
        while i <u len {
            c = s[i] as i32_u;
            i += 1;
            if c != '_' {
                s'[j] = c;
                j += 1;
            }
        }
        len = s'.length();
        s = s';
    }
    i = 0;
    'skip_spaces: loop {
        if i <u len {
            if on_whitespace(s, i) {
                i += 1;
                br 'skip_spaces;
            }
        }
    }
    let start = i;
    'error: do {
        br_if 'error i == len;
        br_if 'error on_whitespace(s, len - 1);
        c = s[i] as i32_u;
        let negative: i32;
        if c == '-' {
            negative = 1;
            i += 1;
        }
        if c == '+' {
            i += 1;
        }
        let (f, ok) = parse_decimal_fast(s, i, len);
        if ok {
            return { f: negative?-f:f };
        }
        if i + 2 <u len {
            if s[i] as i32_u == '0' {
                if (s[i + 1] as i32_u & 0xdf) == 'X' {
                    f = caml_float_of_hex(err_msg, s, i + 2);
                    if negative {
                        f = -f;
                    }
                    return { f };
                }
            }
        }
        if i + 3 == len {
            c = s[i] as i32_u;
            if (c & 0xdf) == 'N' {
                i += 1;
                c = s[i] as i32_u;
                if (c & 0xdf) == 'A' {
                    i += 1;
                    c = s[i] as i32_u;
                    if (c & 0xdf) == 'N' {
                        return { f: nan };
                    }
                }
            } else {
                if (c & 0xdf) == 'I' {
                    i += 1;
                    c = s[i] as i32_u;
                    if (c & 0xdf) == 'N' {
                        i += 1;
                        c = s[i] as i32_u;
                        if (c & 0xdf) == 'F' {
                            return { f: negative?-inf:inf };
                        }
                    }
                }
            }
        }
        if i + 8 == len {
            c = s[i] as i32_u;
            if (c & 0xdf) == 'I' {
                i += 1;
                c = s[i] as i32_u;
                if (c & 0xdf) == 'N' {
                    i += 1;
                    c = s[i] as i32_u;
                    if (c & 0xdf) == 'F' {
                        i += 1;
                        c = s[i] as i32_u;
                        if (c & 0xdf) == 'I' {
                            i += 1;
                            c = s[i] as i32_u;
                            if (c & 0xdf) == 'N' {
                                i += 1;
                                c = s[i] as i32_u;
                                if (c & 0xdf) == 'I' {
                                    i += 1;
                                    c = s[i] as i32_u;
                                    if (c & 0xdf) == 'T' {
                                        i += 1;
                                        c = s[i] as i32_u;
                                        if (c & 0xdf) == 'Y' {
                                            return { f: negative?-inf:inf };
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        let buffer: i32;
        let buf: i32;
        #[if(wasi)]
        {
            // wasi-libc's strtod returns +0 for some negative values that round
            // to the smallest subnormal or to zero: for a negative decimal
            // literal, parse its absolute value instead
            j = 0;
            if (s[start] as i32_u == '-') & (start + 1 <u len) {
                c = s[start + 1] as i32_u;
                if (c - '0' <u 10) | (c == '.') {
                    j = start + 1;
                    len -= j;
                    s' = [0; len];
                    s'.copy(0, s, j, len);
                    s = s';
                }
            }
            buffer = get_buffer();
            buf = write_string_to_memory(buffer + 4, IO_BUFFER_SIZE, s);
            f = strtod(buf, buffer);
            release_memory(buffer + 4, buf);
            br_if 'error m.load32(buffer) != buf + len;
            if j {
                f = -f;
            }
        }
        #[else]
        {
            // The JS number coercion below accepts things OCaml does not,
            // e.g. binary/octal literals ("0b101", "0o17"); only a plain
            // decimal float can reach this point, so reject any character
            // that cannot appear in one. Start after the leading spaces already
            // skipped above.
            i = start;
            while i <u len : (i += 1) {
                c = s[i] as i32_u;
                br_if 'error
                    !((c - '0' <u 10)
                          | ((c == '.') | (((c & 0xdf) == 'E') | ((c == '+') | (c == '-')))));
            }
            f = parse_float(jsstring_of_bytes(s));
            br_if 'error f != f;
        }
        return { f };
    }
    caml_failwith(err_msg);
    return 0 as &i31;
}

const float_of_string = "float_of_string";

#[export]
fn caml_float_of_string(s: &eq) -> &eq {
    become caml_parse_float(float_of_string, s);
}

#[export]
fn caml_nextafter_float(x: f64, y: f64) -> f64 {
    if x != x {
        return x;
    }
    if y != y {
        return y;
    }
    if x == y {
        return y;
    }
    if x == 0 {
        if y >= 0 {
            return 0x1p-1074;
        } else {
            return -0x1p-1074;
        }
    } else {
        let i = x.to_bits();
        let j = y.to_bits();
        if (i <s j) & (i <u j) {
            i += 1;
        } else {
            i -= 1;
        }
        return i.from_bits();
    }
}

#[export]
fn caml_classify_float(x: f64) -> i32 {
    let a = x.abs();
    if a >= 0x1p-1022 {
        if a < inf {
            0;
        } // normal
        else {
            3;
        }
    } // infinity
    else {
        if a == 0 {
            2;
        } // zero
        else {
            if a == a {
                1;
            } // subnormal
            else {
                4;
            }
        }
    }
} // nan

#[export]
fn caml_modf_float(v: &eq) -> &eq {
    let x = (v as &float).f;
    let a = x.abs();
    let i: f64;
    let f: f64;
    if a >= 0 {
        if a < inf { // normal
            i = a.floor();
            f = a - i;
            i = i.copysign(x);
            f = f.copysign(x);
        } else { // infinity
            i = x;
            f = (0).copysign(x);
        }
    } else { // zero or nan
        i = x;
        f = x;
    }
    [block|0 as &i31, { f }, { f: i }];
}

// a * b mod m, for a, b < m < 2^53. The quotient is estimated with
// floating-point arithmetic; it is off by at most a few units, so the
// remainder computed with wrapping 64-bit arithmetic is exact (its
// absolute value is below 2^56) and only needs a small adjustment.
fn mulmod(a: i64, b: i64, m: i64) -> i64 {
    let r = a * b - m * (a as f64_u * b as f64_u / m as f64_u) as i64_u_strict;
    while r <s 0 {
        r += m;
    }
    while r >=s m {
        r -= m;
    }
    r;
}

// 2^d mod m, for d > 0 and 1 < m < 2^53 (binary exponentiation)
fn pow2mod(d: i32, m: i64) -> i64 {
    let r: i64 = 1;
    let i = 31 - d.clz();
    'bit: loop {
        r = mulmod(r, r, m);
        if d >>u i & 1 {
            r <<= 1;
            if r >=u m {
                r -= m;
            }
        }
        i -= 1;
        br_if 'bit i >=s 0;
    }
    r;
}

// The remainder of x / y, rounded toward zero (as C's fmod): with
// x = mx * 2^ex and y = my * 2^ey (mx and my integers, ex >= ey when
// |x| > |y|), it is (mx * 2^(ex - ey) mod my) * 2^ey, with the sign
// of x. This is computed exactly with integer arithmetic, up to 63
// bits at a time, or with modular exponentiation.
#[export]
fn caml_fmod_f64(x: f64, y: f64) -> f64 {
    let ax = x.to_bits() & 0x7fffffffffffffff;
    let ay = y.to_bits() & 0x7fffffffffffffff;
    // x infinite or nan, y zero or nan
    if (ax >=u 0x7ff0000000000000) | (!ay | (ay >u 0x7ff0000000000000)) {
        return nan;
    }
    if ax <=u ay {
        return ax == ay?0 * x:x;
    }
    let ex = (ax >>u 52) as i32;
    let mx = ax & 0xfffffffffffff;
    if ex {
        mx |= 0x10000000000000;
        ex -= 1075;
    } else {
        ex = -1074;
    }
    let ey = (ay >>u 52) as i32;
    let my = ay & 0xfffffffffffff;
    if ey {
        my |= 0x10000000000000;
        ey -= 1075;
    } else {
        ey = -1074;
    }
    let d = ex - ey;
    // Remove the trailing zeros of my (as long as ey <= ex), so that
    // more bits are processed at each step
    let s = my.ctz() as i32;
    if s >s d {
        s = d;
    }
    my >>u= s as i64_u;
    ey += s;
    d -= s;
    mx %u= my;
    // as mx < my, mx * 2^s does not overflow for s <= clz(my)
    s = my.clz() as i32;
    // When many steps would be needed (more than 20: large x / y and y
    // with many significant bits), use mx * (2^d mod my) mod my instead
    if (mx != 0) & (d >s s * 20) {
        mx = mulmod(mx, pow2mod(d, my), my);
        d = 0;
    }
    while (d >s 0) & (mx != 0) : (d -= s) {
        if d <s s {
            s = d;
        }
        mx = (mx << s as i64_u) %u my;
    }
    // mx * 2^ey is exact: mx < 2^53 and ey >= -1074
    (mx as f64_u
         * if ey >=s -1022 {
               (ey + 1023) as i64_u << 52;
           } else {
               1 << (ey + 1074) as i64_u;
           }.from_bits()).copysign(
        x,
    );
}

#[export = "caml_ldexp_float"]
fn ldexp(x: f64, n: i32) -> f64 {
    if n >s 1023 {
        x *= 0x1p1023;
        n -= 1023;
        if n >s 1023 {
            // subnormal
            x *= 0x1p1023;
            n -= 1023;
            if n >s 1023 {
                n = 1023;
            }
        }
    } else {
        if n <s -1022 {
            x *= 0x1p-969;
            n += 969;
            if n <s -1022 {
                x *= 0x1p-969;
                n += 969;
                if n <s -1022 {
                    n = -1022;
                }
            }
        }
    }
    x * ((n as i64_s + 0x3ff) << 52).from_bits();
}

fn frexp(x: f64) -> (f64, i32) {
    let y = x.to_bits();
    let e = 0x7ff & (y >>u 52) as i32;
    if !e {
        if x != 0 {
            let (r_0, r_1) = frexp(x * 0x1p64);
            return (r_0, r_1 - 64);
        } else {
            return (x, 0);
        }
    } else {
        if e == 0x7ff {
            return (x, 0);
        }
    }
    (y & 0x800fffffffffffff | 0x3fe0000000000000).from_bits();
    e - 0x3fe;
}

#[export]
fn caml_frexp_float(v: &eq) -> &eq {
    let (r_0, r_1) = frexp((v as &float).f);
    [block|0 as &i31, { f: r_0 }, r_1 as &i31];
}

// erf and erfc are ported from FreeBSD's msun (s_erf.c), through musl:
//
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//
// Developed at SunPro, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
//
// The JavaScript runtime (ieee_754.js) performs the same operations in
// the same order.

// (erf(x) - x) / x, for |x| < 0.84375, as a function of z = x * x
fn erf_ratio(z: f64) -> f64 {
    // r = pp0 + z * (pp1 + z * (pp2 + z * (pp3 + z * pp4)))
    let r = -2.37630166566501626084e-5;
    r = -5.77027029648944159157e-3 + z * r;
    r = -2.84817495755985104766e-2 + z * r;
    r = -3.2504210724700149937e-1 + z * r;
    r = 1.28379167095512558561e-1 + z * r;
    // s = 1 + z * (qq1 + z * (qq2 + z * (qq3 + z * (qq4 + z * qq5))))
    let s = -3.9602282787753681232e-6;
    s = 1.32494738004321644526e-4 + z * s;
    s = 5.08130628187576562776e-3 + z * s;
    s = 6.50222499887672944485e-2 + z * s;
    s = 3.97917223959155352819e-1 + z * s;
    s = 1 + z * s;
    r / s;
}

// erfc(x), for 0.84375 <= x < 28
fn erfc_abs(x: f64) -> f64 {
    let s: f64;
    let r: f64;
    let q: f64;
    if x < 1.25 {
        // erf(1 + s) - erx
        s = x - 1;
        // r = pa0 + s * (pa1 + ... + s * pa6)
        r = -2.166375594868790843e-3;
        r = 3.54783043256182359371e-2 + s * r;
        r = -1.10894694282396677476e-1 + s * r;
        r = 3.18346619901161753674e-1 + s * r;
        r = -3.72207876035701323847e-1 + s * r;
        r = 4.14856118683748331666e-1 + s * r;
        r = -2.36211856075265944077e-3 + s * r;
        // q = 1 + s * (qa1 + ... + s * qa6)
        q = 1.1984499846799107417e-2;
        q = 1.36370839120290507362e-2 + s * q;
        q = 1.26171219808761642112e-1 + s * q;
        q = 7.18286544141962662868e-2 + s * q;
        q = 5.40397917702171048937e-1 + s * q;
        q = 1.06420880400844228286e-1 + s * q;
        q = 1 + s * q;
        // 1 - erx - r / q
        return 1 - 8.45062911510467529297e-1 - r / q;
    }
    // erfc(x) = exp(-x * x - 0.5625 + r / q) / x
    s = 1 / (x * x);
    if x < 2.8571414947509766 {
        // x < 1 / 0.35
        // r = ra0 + s * (ra1 + ... + s * ra7)
        r = -9.81432934416914548592;
        r = -8.12874355063065934246e1 + s * r;
        r = -1.84605092906711035994e2 + s * r;
        r = -1.62396669462573470355e2 + s * r;
        r = -6.23753324503260060396e1 + s * r;
        r = -1.05586262253232909814e1 + s * r;
        r = -6.93858572707181764372e-1 + s * r;
        r = -9.86494403484714822705e-3 + s * r;
        // q = 1 + s * (sa1 + ... + s * sa8)
        q = -6.04244152148580987438e-2;
        q = 6.57024977031928170135 + s * q;
        q = 1.08635005541779435134e2 + s * q;
        q = 4.29008140027567833386e2 + s * q;
        q = 6.45387271733267880336e2 + s * q;
        q = 4.34565877475229228821e2 + s * q;
        q = 1.376577541435190426e2 + s * q;
        q = 1.96512716674392571292e1 + s * q;
        q = 1 + s * q;
    } else {
        // r = rb0 + s * (rb1 + ... + s * rb6)
        r = -4.83519191608651397019e2;
        r = -1.02509513161107724954e3 + s * r;
        r = -6.37566443368389627722e2 + s * r;
        r = -1.60636384855821916062e2 + s * r;
        r = -1.77579549177547519889e1 + s * r;
        r = -7.99283237680523006574e-1 + s * r;
        r = -9.86494292470009928597e-3 + s * r;
        // q = 1 + s * (sb1 + ... + s * sb7)
        q = -2.24409524465858183362e1;
        q = 4.74528541206955367215e2 + s * q;
        q = 2.55305040643316442583e3 + s * q;
        q = 3.19985821950859553908e3 + s * q;
        q = 1.53672958608443695994e3 + s * q;
        q = 3.25792512996573918826e2 + s * q;
        q = 3.03380607434824582924e1 + s * q;
        q = 1 + s * q;
    }
    // z is x with the low 32 bits of its significand cleared, so that
    // z * z is exact and -x * x = -z * z + (z - x) * (z + x)
    let z = (x.to_bits() & 0xffffffff00000000).from_bits();
    exp(-z * z - 0.5625) * exp((z - x) * (z + x) + r / q) / x;
}

#[export]
fn caml_erf_float(x: f64) -> f64 {
    let a = x.abs();
    if a < 0.84375 {
        if a < 0x1p-28 {
            // the scaling avoids underflows
            return 0.125 * (8 * x + 1.02703333676410069053 * x);
        }
        return x + x * erf_ratio(x * x);
    }
    let y: f64;
    if a < 6 {
        y = 1 - erfc_abs(a);
    } else {
        if x != x {
            return x;
        }
        y = 1;
    }
    y.copysign(x);
}

#[export]
fn caml_erfc_float(x: f64) -> f64 {
    let a = x.abs();
    let y: f64;
    if a < 0.84375 {
        if a < 0x1p-56 {
            return 1 - x;
        }
        y = erf_ratio(x * x);
        if x < 0.25 {
            return 1 - (x + x * y);
        }
        return 0.5 - (x - 0.5 + x * y);
    }
    if a < 28 {
        y = erfc_abs(a);
        return
            if x < 0 {
                2 - y;
            } else {
                y;
            };
    }
    if x != x {
        return x;
    }
    if x < 0 {
        2;
    } else {
        0;
    }
}

// When x has at most 26 significant bits (so that it is not the result
// of a rounding) and y is nonzero, move x slightly in the direction of y
fn fma_adjust(x: f64, y: f64) -> f64 {
    let t: f64;
    if (x != 0) & (y != 0) & ((t := 0x8000001 * x) - (t - x) == x) {
        x * (1 + ((x < 0) == (y < 0)?0x1p-52:-0x1p-52));
    } else {
        x;
    }
}

// x * y + z, rounded once, also when the result is subnormal. The
// operands are scaled so that x * y does
// not overflow or underflow; the exact product is computed with
// Dekker's algorithm, summed with z with error-free transformations
// (TwoSum), and the sum is rounded once (with a final correction for
// subnormal results). Same algorithm as in the JavaScript runtime.
fn fma(x: f64, y: f64, z: f64) -> f64 {
    if (x == 0) | (y == 0) | ((x - x != 0) | (y - y != 0)) {
        return x * y + z;
    }
    if z == 0 {
        return x * y;
    }
    if z - z != 0 {
        return z;
    }
    // scale x and y to [2^-416, 2^416]
    let scale: f64 = 1;
    while x.abs() > 0x1p416 : (x *= 0x1p-416) {
        scale *= 0x1p416;
    }
    while y.abs() > 0x1p416 : (y *= 0x1p-416) {
        scale *= 0x1p416;
    }
    if scale == inf {
        return x * y * scale;
    }
    while x.abs() < 0x1p-416 : (x *= 0x1p416) {
        scale *= 0x1p-416;
    }
    while y.abs() < 0x1p-416 : (y *= 0x1p416) {
        scale *= 0x1p-416;
    }
    if scale == 0 {
        return z;
    }
    // z / scale, without arithmetic on a subnormal z, which is slow
    let zs =
        if scale == 1 {
            z;
        } else {
            if z.abs() >= 0x1p-1022 {
                z / scale;
            } else {
                if scale > 1 {
                    // negligible: only its sign matters
                    (0x1p-1022).copysign(z);
                } else {
                    // z = m * 2^-1074, and 2^-1074 / scale =
                    // (2^-1022 / scale) * 2^-52 is normal
                    ((z.to_bits() & 0x000fffffffffffff) as f64_u).copysign(z)
                        * (0x1p-1022 / scale * 0x1p-52);
                }
            }
        };
    let xy = (x * y).abs();
    // z much larger than x * y (|zs| > |xy| * 4 / EPSILON)
    if zs.abs() > xy * 0x1p54 {
        return z;
    }
    // z much smaller than x * y: only its sign matters
    // (|zs| < |xy| * EPSILON / 4 * EPSILON / 4)
    if zs.abs() < xy * 0x1p-108 {
        zs = (0x1p-1022).copysign(z);
    }
    let t: f64;
    // p + e = x * y (Dekker)
    let xhi = (t := 0x8000001 * x) - (t - x);
    let xlo = x - xhi;
    let yhi = (t := 0x8000001 * y) - (t - y);
    let ylo = y - yhi;
    let p = x * y;
    let e = xhi * yhi - p + xhi * ylo + xlo * yhi + xlo * ylo;
    // s + se = p + zs
    let s = p + zs;
    let v = s - p;
    let se = p - (s - v) + (zs - v);
    // u + ue = e + se
    let u = e + se;
    v = u - e;
    let ue = e - (u - v) + (se - v);
    // i + ie = s + u
    let i = s + u;
    v = i - s;
    let ie = s - (i - v) + (u - v);
    let f = i + fma_adjust(ie, ue);
    if f == 0 {
        return f;
    }
    if scale >= 1 {
        return f * scale;
    }
    // 2^-1022 in the scaled domain
    let g = 0x1p-1022 / scale;
    if f.abs() >= g {
        return f * scale;
    }
    // Subnormal result, computed without arithmetic on subnormals, which
    // is slow. Round f to the grid of the result (g * 2^-52) by adding
    // k = +/-g. Rounding f rather than the exact sum may create a tie or
    // resolve one the wrong way: correct it in the direction of the rest
    // of the exact sum, i + ie + ue - f (ie alone can have the wrong sign
    // when ue moved f past a tie). The result is t * scale, with t a
    // multiple of the grid: build it from the integer t / (g * 2^-52).
    let k = g.copysign(f);
    let rc = f + k;
    v = i - f + ie;
    t = rc + fma_adjust(f - (rc - k), v != 0?v:ue) - k;
    ((t / (g * 0x1p-52)).abs() as i64_u_strict | f.to_bits() & 0x8000000000000000).from_bits();
}

// x * y + z, rounded once, with the algorithm of Boldo and Melquiond
// (exact product, TwoSum, rounding to odd), after scaling the operands
// into a safe range. Scaling the result back would round a second time
// when it is subnormal: the slower $fma is used when it can be.
#[export]
fn caml_fma_float(x0: f64, y0: f64, z0: f64) -> f64 {
    let x = x0;
    let y = y0;
    let z = z0;
    let v3: i64;
    let v4: i64;
    let v5: i64;
    let v6: i64;
    let v7 = (v4 := (v3 := y.to_bits()) >>u 52 & 2047) + (v6 := (v5 := x.to_bits()) >>u 52 & 2047);
    let v8 = z.to_bits();
    // A nonzero x * y + z below 2^-1022 in magnitude implies
    // |x * y| < 2^-916 and |z| < 2^-916 (the exact sum is a multiple
    // of ulp(x) * ulp(y) and of ulp(z)). Use the slower algorithm
    // directly in that case rather than after the fast path: with
    // subnormal values, each multiplication costs a microcode assist.
    if (v7 <=u 1129) & ((v8 & 0x7ff0000000000000) <=u 0x06b0000000000000) {
        become fma(x0, y0, z0);
    }
    let v9: i32;
    let v10: i32;
    'label_1: do {
        'label_2: do {
            br_if 'label_2 v4 >u 1993;
            br_if 'label_2 v6 >u 1993;
            br_if 'label_2 v7 >u 3016;
            br_if 'label_2 (v8 & 0x7fe0000000000000) >u 0x7c90000000000000;
            v9 = 0;
            br_if 'label_2 v7 <=u 1076;
            v10 = 0;
            br 'label_1;
        }
        v8 = v8 >>u 52 & 2047;
        'cont: do {
            br_if 'cont v4 == 2047;
            br_if 'cont v6 == 2047;
            br_if 'cont v8 != 2047;
            return x + z + y;
        }
        'cont: do {
            br_if 'cont y == 0;
            br_if 'cont x == 0;
            br_if 'cont z != 0;
            return x * y;
        }
        'cont: do {
            'then: do {
                br_if 'then v6 == 2047;
                br_if 'then v4 == 2047;
                br_if 'then y == 0;
                br_if 'then x == 0;
                br_if 'cont v8 != 2047;
            }
            return x * y + z;
        }
        'cont: do {
            br_if 'cont v7 <u 3071;
            return x * y;
        }
        'cont: do {
            br_if 'cont v7 >u 967;
            y = (v3 ^ v5) >s -1?0x1p-1074:-0x1p-1074;
            'cont2: do {
                br_if 'cont2 v8 <u 3;
                return y + z;
            }
            return (z * 0x1p54 + y) * 0x1p-54;
        }
        'label_10: do {
            'label_11: do {
                'label_12: do {
                    br_if 'label_12 v7 <u 3017;
                    z = v8 >u 53?z * 0x1p-53:z;
                    x = (v9 := v6 >u v4)?x * 0x1p-53:x;
                    y = v9?y:y * 0x1p-53;
                    br 'label_11;
                }
                br_if 'label_10 v8 <u 1994;
                'label_13: do {
                    'label_14: do {
                        br_if 'label_14 v7 >u 1129;
                        'label_15: do {
                            br_if 'label_15 v6 <=u v4;
                            x *= 0x1p108;
                            br 'label_13;
                        }
                        y *= 0x1p108;
                        br 'label_13;
                    }
                    'label_16: do {
                        br_if 'label_16 v6 <=u v4;
                        x = v6 >u 53?x * 0x1p-53:x;
                        br 'label_13;
                    }
                    y = v4 >u 53?y * 0x1p-53:y;
                }
                z *= 0x1p-53;
            }
            v10 = 0;
            v9 = 1;
            br 'label_1;
        }
        'label_17: do {
            'label_18: do {
                br_if 'label_18 v6 <u 1994;
                y *= 0x1p53;
                x *= 0x1p-53;
                br 'label_17;
            }
            'label_19: do {
                br_if 'label_19 v4 <u 1994;
                x *= 0x1p53;
                y *= 0x1p-53;
                br 'label_17;
            }
            z = (v10 := v8 <u 219)?z * 0x1p108:z;
            x = (v9 := v6 >u v4)?x * 0x1p108:x;
            y = v9?y:y * 0x1p108;
            v9 = 0;
            br 'label_1;
        }
        v9 = 0;
        v10 = 0;
    }
    'cont: do {
        br_if 'cont z != 0;
        br_if 'cont !((y == 0) | (x == 0));
        return x * y + z;
    }
    let v11: f64;
    let v12: f64;
    let v13: f64;
    let v14: f64;
    let v15: f64;
    x =
        (v12 := x - (v11 := (v11 := x * 0x8000001) - (v11 - x)))
            * (v14 := y - (v13 := (v13 := y * 0x8000001) - (v13 - y)))
            - ((v15 := y * x) - v11 * v13 - v12 * v13 - v11 * v14);
    let exact: i32;
    'label_21: do {
        'label_22: do {
            br_if 'label_22 (y := z + v15) != 0;
            // exact zero
            if x == 0 {
                exact = 1;
                br 'label_21;
            }
        }
        'cont: do {
            br_if 'cont
                (z :=
                     (v11 :=
                          x
                              - (v13 :=
                                     (z := (v11 := v15 - (v11 := y - z) + (z - (y - v11))) + x)
                                         - v11) + (v11 - (z - v13)))
                         + ((y := z - (v13 := (x := y + z) - y) + (y - (x - v13)))
                                - (y := v11 + y))) == 0;
            br_if 'cont (v4 := y.to_bits()) as i32 & 1;
            y = (((y < 0) ^ (z > 0)?1:-1) + v4).from_bits();
        }
        y = x + y;
        'cont: do {
            br_if 'cont !v9;
            return y * 0x1p53;
        }
        y = v10?y * 0x1p-108:y;
    }
    // If the result is subnormal (it can be one ulp off, so this includes
    // 2^-1022 and zero), use the slower algorithm
    if !exact & (y.abs() <= 0x1p-1022) {
        return fma(x0, y0, z0);
    }
    y;
}

#[export]
fn caml_float_compare(x: f64, y: f64) -> i32 {
    (x > y) - (x < y) + ((x == x) - (y == y));
}

#[export]
fn caml_round_float(x: f64) -> f64 {
    let y: f64;
    if x >= 0 {
        y = x.floor();
        if x - y >= 0.5 {
            y + 1;
        } else {
            y;
        }
    } else {
        y = x.ceil();
        if y - x >= 0.5 {
            y - 1;
        } else {
            y;
        }
    }
}
