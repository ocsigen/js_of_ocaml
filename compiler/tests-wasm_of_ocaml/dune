 (modes js wasm)
 (js_of_ocaml
  (flags :standard --disable optcall --no-inline))
 (wasm_of_ocaml
  (flags :standard --disable optcall --no-inline)))

(tests
 (names fun_eq open_append exn_wrapper)
 (modes js wasm))

(tests
 (names marshal_regressions int_and)
 (modes wasm))

(tests
 (names globalize_assign)
 (modes wasm)
 ; With -g, ocamlc does not turn the reference into a mutable variable
 (flags
  (:standard \ -g))
 (ocamlc_flags ())
 (wasm_of_ocaml
  (flags :standard -w no-missing-debug-event)))

(tests
 (names assign)
 (modes js wasm)
 ; With -g, ocamlc does not turn the references into mutable variables
 (flags
  (:standard \ -g))
 (ocamlc_flags ())
 (js_of_ocaml
  (flags :standard -w no-missing-debug-event)
  (link_flags :standard -w no-missing-debug-event))
 (wasm_of_ocaml
  (flags :standard -w no-missing-debug-event)
  (link_flags :standard -w no-missing-debug-event)))

