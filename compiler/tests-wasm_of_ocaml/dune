(tests
 (names jsstring_buffer)
 (modes wasm)
 (libraries compiler-libs.common js_of_ocaml)
 ; Compressed marshalling requires OCaml 5.2 and is not available under OxCaml.
 ; The buffer this exercises is specific to the non-wasi runtime.
 (build_if
  (and
   (>= %{ocaml_version} 5.2)
   (not %{oxcaml_supported})
   (<> %{env:JSOO_TEST_ENGINE=node} wasi))))

(tests
 (names gh2093)
 (modes wasm)
 (enabled_if
  (and
   (>= %{ocaml_version} 5)
   (<> %{profile} wasi)))
 (wasm_of_ocaml
  (compilation_mode whole_program)
  (flags :standard)))

(tests
 (names bigarray_generic)
 (modes wasm)
 ; Generic bigarray accesses are only specialized when the type analysis knows
 ; the kind and layout of the bigarray, which requires whole-program
 ; compilation.
 (wasm_of_ocaml
  (compilation_mode whole_program)
  (flags :standard)))

(tests
 (names bigarray_dim)
 (modes js wasm)
 ; Bigarray accesses are specialized when the type analysis knows the kind
 ; and layout of the bigarray
 (wasm_of_ocaml
  (compilation_mode whole_program)
  (flags :standard --opt 2)))

(tests
 (names int_range)
 (modes js wasm)
 ; The range analysis relies on the global flow analysis, which is more
 ; precise at --opt 2 and with whole-program compilation
 (wasm_of_ocaml
  (compilation_mode whole_program)
  (flags :standard --opt 2)))

(tests
 (names bound_checks)
 (modes js wasm)
 ; The range analysis relies on the global flow analysis, which is more
 ; precise at --opt 2 and with whole-program compilation
 (wasm_of_ocaml
  (compilation_mode whole_program)
  (flags :standard --opt 2)))

(tests
 (names string_interning)
 (modes wasm))

(tests
 (names handler_shortcut)
 (modes js wasm)
 ; Without -g, ocamlc turns local references into mutable variables,
 ; which exercises Assign instructions
 (ocamlc_flags ())
 ; Source maps are enabled in dev mode, where they warn about the missing
 ; debug information. (Passing --no-source-map instead would fail in
 ; release mode, where dune passes it already and the option cannot be
 ; repeated.)
 (js_of_ocaml
  (flags :standard -w no-missing-debug-event)
  (link_flags :standard -w no-missing-debug-event))
 (wasm_of_ocaml
  (flags :standard -w no-missing-debug-event)
  (link_flags :standard -w no-missing-debug-event)))

(tests
 (names local_sink_exn)
 (modes js wasm)
 ; The bug only shows up without debug information
 (ocamlc_flags ())
 ; Source maps are enabled in dev mode, where they warn about the missing
 ; debug information. (Passing --no-source-map instead would fail in
 ; release mode, where dune passes it already and the option cannot be
 ; repeated.)
 (js_of_ocaml
  (flags :standard -w no-missing-debug-event)
  (link_flags :standard -w no-missing-debug-event))
 (wasm_of_ocaml
  (flags :standard -w no-missing-debug-event)
  (link_flags :standard -w no-missing-debug-event)))

(tests
 (names clone_higher_order)
 (modes wasm)
 ; Higher-order functions are only cloned at -O2 and -O3, when the global
 ; flow analysis is precise.
 (wasm_of_ocaml
  (compilation_mode whole_program)
  (flags :standard --opt 2)))

; The programs compiled here run Wasm code and rely on Node's module
; resolution (`require`, `require.main`). QuickJS provides neither, so these
; tests are skipped under the `quickjs` profile.

(cram
 (deps %{bin:wasm_of_ocaml})
 (enabled_if
  (<> %{profile} quickjs)))

(cram
 (applies_to split_toplevel_pieces)
 (deps split_toplevel.ml split_toplevel_switch.ml))

(tests
 (names js_bool js_float_args js_int_args js_string_cache)
 (modes js wasm)
 (libraries js_of_ocaml)
 ; The js_of_ocaml library is not compatible with WASI
 (build_if
  (<> %{env:JSOO_TEST_ENGINE=node} wasi))
 ; Without -g, ocamlc turns the reference into a mutable variable
 (flags
  (:standard \ -g))
 (ocamlc_flags ())
 (js_of_ocaml
  (flags :standard -w no-missing-debug-event)
  (link_flags :standard -w no-missing-debug-event))
 (wasm_of_ocaml
  (flags :standard -w no-missing-debug-event)
  (link_flags :standard -w no-missing-debug-event)))

(cram
 (applies_to globalize_js_float)
 (deps globalize_js_float.ml))
