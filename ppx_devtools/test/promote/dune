; Checks the [.corrected] file the runner writes for mismatching
; expectations, i.e. what [dune promote] would write back to the source.

(executable
 (name promote_me)
 (preprocess
  (pps ppx_devtools.expect)))

(rule
 (targets promote_me.ml.corrected)
 (deps promote_me.ml)
 (action
  (chdir
   %{workspace_root}
   (run
    %{exe:promote_me.exe}
    inline-test-runner
    -source-tree-root
    .
    -diff-cmd
    -))))

(rule
 (alias runtest)
 (action
  (diff promote_me.expected promote_me.ml.corrected)))

; Mismatches must not be lost when the source cannot be read to write the
; [.corrected] file.

(rule
 (targets missing_source.output)
 (action
  (with-accepted-exit-codes
   (or 0 2)
   (with-outputs-to
    missing_source.output
    (run
     %{exe:promote_me.exe}
     inline-test-runner
     -source-tree-root
     missing
     -diff-cmd
     -)))))

(rule
 (alias runtest)
 (action
  (diff missing_source.expected missing_source.output)))
