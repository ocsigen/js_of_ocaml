(executables
 (names main)
 (modules main)
 (libraries
  ppxlib
  toplevel_expect_test
  js_of_ocaml.deriving
  js_of_ocaml-ppx_deriving_json)
 (modes byte)
 (link_flags (-linkall)))

(rule
 (targets ppx.mlt.corrected)
 (deps
  ../../../lib/deriving_json/.js_of_ocaml_deriving.objs/byte/deriving_Json.cmi
  ../../../lib/deriving_json/.js_of_ocaml_deriving.objs/byte/deriving_Json_lexer.cmi)
 (action
  (run %{exe:main.bc} %{dep:ppx.mlt})))

(rule
 (targets gen.mlt.corrected)
 (deps
  ../../../lib/deriving_json/.js_of_ocaml_deriving.objs/byte/deriving_Json.cmi
  ../../../lib/deriving_json/.js_of_ocaml_deriving.objs/byte/deriving_Json_lexer.cmi)
 (action
  (run %{exe:main.bc} %{dep:gen.mlt})))

; Upper bound: OCaml 5.6 changed how polymorphic-variant types are printed
; ([ | poly ] instead of poly), which these toplevel snapshots capture inline.

(rule
 (alias runtest)
 (enabled_if
  (and
   (>= %{ocaml_version} 5.1)
   (< %{ocaml_version} 5.6)))
 ;; (package js_of_ocaml-ppx)
 (action
  (diff ppx.mlt ppx.mlt.corrected)))

(rule
 (alias runtest)
 (enabled_if
  (and
   (>= %{ocaml_version} 5.3)
   (< %{ocaml_version} 5.6)))
 ;; (package js_of_ocaml-ppx)
 (action
  (diff gen.mlt gen.mlt.corrected)))

; The generated functions of a non-recursive type must not trigger
; warning 39 (unused rec flag), an error in dune's dev profile.

(test
 (name unused_rec)
 (modules unused_rec)
 (modes byte)
 (flags
  (:standard -w +39 -warn-error +39))
 (preprocess
  (pps js_of_ocaml-ppx_deriving_json))
 (libraries js_of_ocaml.deriving))
