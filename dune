(rule
 (targets version.ml.in)
 (action
  (with-stdout-to
   %{targets}
   (run
    %{dep:tools/version/gen/gen.exe}
    %{dep:VERSION}
    %{dep:tools/version/GIT-VERSION}))))

(rule
 (target ci.flags)
 (enabled_if
  (not %{env:CI=false}))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))

(rule
 (target ci.flags)
 (enabled_if %{env:CI=false})
 (action
  (with-stdout-to
   %{target}
   (echo "(--debug invariant)"))))

; OxCaml does not track the legacy [Effect.perform], which the effect tests
; use, in its unyielding-call information: with OxCaml, this information is
; not used when compiling the tests. This applies to all the code, since the
; separately compiled libraries (the standard library in particular) run the
; tests' effectful closures too.

(rule
 (target unyielding.flags)
 (enabled_if %{oxcaml_supported})
 (action
  (with-stdout-to
   %{target}
   (echo "(--disable oxcaml-use-unyielding-debuginfo-for-effect-cps)"))))

(rule
 (target unyielding.flags)
 (enabled_if
  (not %{oxcaml_supported}))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))

